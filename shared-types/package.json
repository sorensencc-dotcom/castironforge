{
  "name": "@castironforge/shared-types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for Phase-5 outreach automation (chat-frontend, chat-agent, Planning Engine)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.1.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.40.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0"
  },
  "keywords": [
    "castironforge",
    "outreach",
    "automation",
    "types",
    "typescript"
  ],
  "author": "RewriteLabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sorensencc-dotcom/castironforge.git",
    "directory": "shared-types"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
