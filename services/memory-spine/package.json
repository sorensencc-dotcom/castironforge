{
  "name": "@castironforge/memory-spine",
  "version": "0.1.0",
  "description": "CIC Memory Spine — deterministic knowledge layer for CIC agents",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "node --loader ts-node/esm scripts/seed.ts",
    "seed:dry": "DRY_RUN=1 node --loader ts-node/esm scripts/seed.ts",
    "generate-dataset": "node --loader ts-node/esm scripts/generate-dataset.ts",
    "generate-dataset:dry": "DRY_RUN=1 node --loader ts-node/esm scripts/generate-dataset.ts",
    "generate-dataset-hybrid": "node --loader ts-node/esm scripts/generate-dataset-hybrid.ts",
    "generate-dataset-hybrid:dry": "DRY_RUN=1 node --loader ts-node/esm scripts/generate-dataset-hybrid.ts",
    "generate-dataset-llm": "node --loader ts-node/esm scripts/generate-dataset-llm.ts",
    "generate-dataset-llm:dry": "DRY_RUN=1 node --loader ts-node/esm scripts/generate-dataset-llm.ts",
    "calibrate-confidence": "node --loader ts-node/esm scripts/calibrate-confidence.ts",
    "train-memory-v1": "bash scripts/train-memory-v1.sh",
    "train-memory-v1:validate": "python3 scripts/train.py --dry_run",
    "train-memory-v1:py": "python3 scripts/train.py"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
