{
  "name": "@castironforge/memory-spine",
  "version": "0.1.0",
  "description": "CIC Memory Spine — deterministic knowledge layer for CIC agents",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "node --loader ts-node/esm scripts/seed.ts",
    "seed:dry": "DRY_RUN=1 node --loader ts-node/esm scripts/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
