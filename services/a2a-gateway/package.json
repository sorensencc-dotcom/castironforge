{
  "name": "a2a-gateway",
  "version": "1.1.0",
  "description": "A2A Gateway - translation adapter between CIC Mesh Event Bus and A2A Protocol",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "type-check": "./node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/uuid": "^9.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
